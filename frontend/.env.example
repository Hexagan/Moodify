# Variables nuevas para Configuración > Integraciones (agregalas a tu .env; las de Firebase siguen igual).

# Spotify: app en https://developer.spotify.com/dashboard con Redirect URI <origen>/configuracion
# (ej. http://127.0.0.1:5173/configuracion en desarrollo). Solo el Client ID: el flujo PKCE no usa secreto.
VITE_SPOTIFY_CLIENT_ID=
# Opcional, si la Redirect URI registrada no es <origen>/configuracion
# VITE_SPOTIFY_REDIRECT_URI=

# YouTube: cliente OAuth 'Aplicación web' en Google Cloud con YouTube Data API v3 habilitada
# y el origen del sitio en 'Orígenes autorizados de JavaScript'.
VITE_GOOGLE_CLIENT_ID=
