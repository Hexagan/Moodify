# Copiá este archivo como .env (no se sube al repositorio) y completá lo que tengas.

# Base de datos (si no se define, se usa postgresql://postgres:1234@localhost:5432/moodify)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/moodify

# YouTube Data API v3: reproducción completa en YouTube Music y búsqueda en el ABM.
# Gratis desde https://console.cloud.google.com (cuota diaria de 10.000 unidades = ~100 búsquedas).
YOUTUBE_API_KEY=

# Spotify Web API (opcional): búsqueda en Spotify en el ABM para autocompletar canciones.
# Crear una app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
