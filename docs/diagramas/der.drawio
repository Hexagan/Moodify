urce="t_song_media" target="t_songs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="name ∈ songs.artists (lógica)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0.5;exitY=0;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_artists" target="t_songs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="20"/><mxPoint x="185" y="20"/></Array></mxGeometry></mxCell><mxCell id="c37" value='&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; único&lt;br&gt;Línea continua: FK declarada en la base. Línea punteada: relación lógica, sin FK.&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas de diseño&lt;/b&gt;&lt;br&gt;• &lt;i&gt;songs&lt;/i&gt; conserva el dataset original de Spotify: una canción aparece una vez por género&lt;br&gt;  y &lt;i&gt;artists&lt;/i&gt; guarda varios nombres separados por ";". Las consultas deduplican al leer.&lt;br&gt;• &lt;i&gt;artists&lt;/i&gt; se arma a partir de &lt;i&gt;songs&lt;/i&gt; (artist_index.py) y enlaza por nombre.&lt;br&gt;• &lt;i&gt;song_media&lt;/i&gt; cachea portada, preview y video por track_id de Spotify.&lt;br&gt;• Los &lt;i&gt;uid&lt;/i&gt; de usuario vienen de Firebase Authentication.&lt;br&gt;&lt;br&gt;&lt;font color="#6c8ebf"&gt;■&lt;/font&gt; Catálogo  &lt;font color="#9673a6"&gt;■&lt;/font&gt; Actividad del usuario  &lt;font color="#82b366"&gt;■&lt;/font&gt; Usuarios  &lt;font color="#d79b00"&gt;■&lt;/font&gt; Foro de artistas' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="650" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>