ll id="c32" edge="1" parent="1" source="t_artist_posts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;fontSize=10;" target="t_artist_threads" value="thread_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" edge="1" parent="1" source="t_artist_posts" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;fontSize=10;" target="t_user_profiles" value="author_uid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" edge="1" parent="1" source="t_user_settings" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;fontSize=10;" target="t_user_profiles" value="uid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" edge="1" parent="1" source="t_song_media" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;" target="t_songs" value="track_id (lógica)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" edge="1" parent="1" source="t_artists" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0.5;exitY=0;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" target="t_songs" value="name ∈ songs.artists (lógica)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="20"/><mxPoint x="185" y="20"/></Array></mxGeometry></mxCell><mxCell id="c37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; único&lt;br&gt;Línea continua: FK declarada en la base. Línea punteada: relación lógica, sin FK.&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas de diseño&lt;/b&gt;&lt;br&gt;• &lt;i&gt;songs&lt;/i&gt; conserva el dataset original de Spotify: una canción aparece una vez por género&lt;br&gt;  y &lt;i&gt;artists&lt;/i&gt; guarda varios nombres separados por &quot;;&quot;. Las consultas deduplican al leer.&lt;br&gt;• &lt;i&gt;artists&lt;/i&gt; se arma a partir de &lt;i&gt;songs&lt;/i&gt; (artist_index.py) y enlaza por nombre.&lt;br&gt;• &lt;i&gt;song_media&lt;/i&gt; cachea portada, preview y video por track_id de Spotify.&lt;br&gt;• Los &lt;i&gt;uid&lt;/i&gt; de usuario vienen de Firebase Authentication.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Catálogo  &lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; Actividad del usuario  &lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; Usuarios  &lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; Foro de artistas" vertex="1"><mxGeometry height="230" width="650" x="40" y="910" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>